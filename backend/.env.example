# Copy this file to ".env" and fill in the real values.
# Never commit the real ".env" file to Git.

# Local development: connect to the PostgreSQL container on EC2
# through the SSH tunnel on localhost:5433.
# Replace YOUR_PASSWORD with POSTGRES_PASSWORD from ~/chuvachi/.env on the EC2 server.
DATABASE_URL="postgresql://chuvachi_admin:YOUR_PASSWORD@localhost:5433/chuvachi_dev?sslmode=disable"

# Port the API listens on
PORT=4000

# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS="http://localhost:3000"

# Product photos on Cloudflare R2 (Cloudflare dashboard > R2).
# Leave these empty and photo upload is simply switched off.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="chuvachi-images"
# Public address of the bucket, without a slash at the end (e.g. https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=""

# Telegram notifications for staff (new orders, auto-cancelled orders).
# Create a bot with @BotFather, add it to the shop's group, then put the group's id here.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Link in the Telegram message that opens the admin orders page
ADMIN_URL="http://localhost:3000/admin/orders"

# Customer sign-in with Google: the "Client ID" from Google Cloud Console (same as the frontend's)
GOOGLE_CLIENT_ID=""

# Cloudflare Turnstile (bot check on placing and looking up orders). Empty = check switched off.
# For local testing you can use Cloudflare's always-pass test key: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=""
