# Copy this file to ".env" and fill in the real values.
# Never commit the real ".env" file to Git.

# Local development: connect to RDS through the SSH tunnel on localhost:5433.
# Replace YOUR_PASSWORD with the RDS master password.
DATABASE_URL="postgresql://chuvachi_admin:YOUR_PASSWORD@localhost:5433/chuvachi_dev?sslmode=require"

# Port the API listens on
PORT=4000

# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS="http://localhost:3000"
