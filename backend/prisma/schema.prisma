// Prisma schema for the Chuvachi dessert shop.
// All money values are stored in VND as whole numbers (Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum OptionType {
  FLAVOR  // e.g. passion fruit mousse, mango panna cotta
  PACKAGE // e.g. single cup, box of 4, box of 6
}

enum PaymentMethod {
  BANK_TRANSFER // the only method for now; COD can be added later
}

enum DeliveryType {
  ASAP      // deliver as soon as the cakes are ready today
  SCHEDULED // deliver on a chosen day and time slot
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum CancelReason {
  OUT_OF_INGREDIENTS
  CANNOT_DELIVER
  CUSTOMER_REQUEST
  SHOP_CLOSED
  UNPAID_TIMEOUT // cancelled automatically: not confirmed in time
  OTHER
}

enum OrderStatus {
  PENDING   // placed, waiting for the bank transfer and the shop's confirmation
  CONFIRMED // payment received, the shop accepted the order
  PREPARING // being made
  READY     // finished, waiting for the driver
  COMPLETED // delivered to the customer
  CANCELLED
}

// Whether customers can order a cake or one of its options right now.
// Unlike "soldOutUntil" (sold out up to a date), these stay until staff change them.
enum Availability {
  AVAILABLE   // can be ordered
  SOLD_OUT    // shown with a "Sold out" label, can't be ordered
  COMING_SOON // shown with a "Coming soon" label, can't be ordered yet
}

// ---------- Catalog ----------

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  nameVi    String
  nameEn    String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id            Int             @id @default(autoincrement())
  slug          String          @unique
  nameVi        String
  nameEn        String
  descriptionVi String?
  descriptionEn String?
  ingredientsVi String?         // shown on the product page
  ingredientsEn String?
  allergensVi   String?         // e.g. "Milk, eggs"; important for customers with allergies
  allergensEn   String?
  imageUrl      String?         // cover photo (always the first of "images"); used on cards and in the cart
  images        String[]        @default([]) // all photos in display order, up to 8
  basePrice     Int             // price of one portion in VND
  isActive      Boolean         @default(true)
  isNew         Boolean         @default(false) // shows a "NEW" badge and appears under the "New" filter
  availability  Availability    @default(AVAILABLE)
  soldOutUntil  DateTime?       @db.Date // "temporarily sold out": no deliveries on or before this day
  dailyLimit    Int?            // most portions of this cake per delivery day; empty = no own limit
  sortOrder     Int             @default(0)
  categoryId    Int
  category      Category        @relation(fields: [categoryId], references: [id])
  options       ProductOption[]
  comboItems    ComboItem[]
  orderItems    OrderItem[]
  seasonItems   SeasonProduct[]
  dayBookings   ProductDayBooking[]
  heroFor       HomeContent[]   @relation("HeroProduct")
  heroSlides    HeroSlide[]     @relation("HeroSlideProduct")
  announcedIn   HomeContent[]   @relation("AnnouncementProduct")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  reviews       Review[]
}

model ProductOption {
  id         Int        @id @default(autoincrement())
  productId  Int
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       OptionType
  nameVi     String
  nameEn     String
  priceDelta Int        @default(0) // extra price added to the base price
  portions   Int        @default(1) // portions per unit (PACKAGE only, e.g. box of 4 = 4)
  isActive   Boolean    @default(true) // false = hidden from customers
  availability Availability @default(AVAILABLE) // shown but maybe not orderable
  dailyLimit Int?       // FLAVOR only: most portions of this flavor per delivery day; empty = no own limit
  sortOrder  Int        @default(0)
  dayBookings ProductOptionDayBooking[]
}

model Combo {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  nameVi        String
  nameEn        String
  descriptionVi String?
  descriptionEn String?
  imageUrl      String?
  price         Int         // fixed combo price in VND
  isActive      Boolean     @default(true)
  items         ComboItem[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ComboItem {
  id        Int     @id @default(autoincrement())
  comboId   Int
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     // number of portions of this product in the combo
}

// ---------- Homepage ----------

// Single-row table (id = 1) with the homepage texts edited in the admin page.
model HomeContent {
  id                      Int      @id @default(1)
  // Thin black bar at the very top of every page
  announcementLeftVi      String?
  announcementLeftEn      String?
  announcementCenterVi    String?
  announcementCenterEn    String?
  announcementRightVi     String?
  announcementRightEn     String?
  announcementProductId   Int?     // the "See it" link opens this cake; empty = the menu
  announcementProduct     Product? @relation("AnnouncementProduct", fields: [announcementProductId], references: [id], onDelete: SetNull)
  // Large dark banner for the newest cake
  heroIsActive            Boolean  @default(true)
  heroEyebrowVi           String?
  heroEyebrowEn           String?
  heroTitleVi             String?
  heroTitleEn             String?
  heroSubtitleVi          String?
  heroSubtitleEn          String?
  heroCtaVi               String?
  heroCtaEn               String?
  heroImageUrl            String?
  heroProductId           Int?     // the button opens this cake; empty = the menu
  heroProduct             Product? @relation("HeroProduct", fields: [heroProductId], references: [id], onDelete: SetNull)
  heroIntervalSeconds     Int      @default(6) // the banner moves to the next slide every N seconds
  updatedAt               DateTime @updatedAt
}

// Extra slides of the homepage banner; they take turns with the main banner above.
// Optional dates limit a slide to a promotion period (inclusive, Vietnam time).
model HeroSlide {
  id         Int       @id @default(autoincrement())
  eyebrowVi  String?
  eyebrowEn  String?
  titleVi    String
  titleEn    String
  subtitleVi String?
  subtitleEn String?
  ctaVi      String?
  ctaEn      String?
  imageUrl   String?
  productId  Int?      // the button opens this cake; empty = the menu
  product    Product?  @relation("HeroSlideProduct", fields: [productId], references: [id], onDelete: SetNull)
  startDate  DateTime? @db.Date
  endDate    DateTime? @db.Date
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// A season: a set of cakes sold during a time window.
// Phase 3 builds the "buy every cake of the season" reward on top of this.
model Season {
  id            Int             @id @default(autoincrement())
  nameVi        String
  nameEn        String
  eyebrowVi     String?         // small text above the name, e.g. "This month"
  eyebrowEn     String?
  descriptionVi String?
  descriptionEn String?
  startDate     DateTime        @db.Date
  endDate       DateTime        @db.Date // last day of the season (included)
  isActive      Boolean         @default(true)
  products      SeasonProduct[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([startDate, endDate])
}

model SeasonProduct {
  seasonId  Int
  season    Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@id([seasonId, productId])
}

// "Coming soon" cards at the bottom of the homepage.
model ComingSoonItem {
  id        Int     @id @default(autoincrement())
  dateLabel String  // free text, e.g. "15/12" or "December"
  nameVi    String
  nameEn    String
  noteVi    String?
  noteEn    String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

// ---------- Orders ----------

model Order {
  id             Int           @id @default(autoincrement())
  code           String        @unique // short code the customer uses to look up the order
  customerName   String
  customerPhone  String
  address        String
  note           String?
  locale         String        @default("vi") // language the customer ordered in
  deliveryZoneId Int
  deliveryZone   DeliveryZone  @relation(fields: [deliveryZoneId], references: [id])
  deliveryType   DeliveryType
  deliveryDate   DateTime      @db.Date // for ASAP orders, the day the order was placed
  deliverySlot   String?       // e.g. "14:00-16:00"; empty for ASAP orders
  totalPortions  Int           // used for the daily capacity and lead time checks
  total          Int           // cakes only; customers pay the shipping fee to the driver
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(UNPAID)
  status         OrderStatus   @default(PENDING)
  privacyConsentAt     DateTime? // when the customer ticked "I agree to the privacy policy"
  privacyPolicyVersion String?   // which version of the policy they agreed to
  anonymizedAt         DateTime? // name, phone and address were erased (retention period over, or on request)
  cancelReason         CancelReason? // shown to the customer when the order is cancelled
  cancelNote           String?   // optional extra words for the customer
  customerId           Int?      // set when the customer was signed in, or claimed the order later
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEditCount    Int       @default(0) // times the customer changed name, phone, address or note
  customerEditedAt     DateTime? // last change by the customer that staff have not looked at yet
  items          OrderItem[]
  events         OrderEvent[]
  reviews        Review[]
  pushWatches    OrderPushWatch[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([deliveryDate])
  @@index([status])
  @@index([status, paymentStatus, createdAt])
  @@index([customerId])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])
  comboId   Int?
  combo     Combo?   @relation(fields: [comboId], references: [id])
  // Snapshots keep the order correct even if the product is renamed or repriced later.
  nameSnapshot    String
  optionsSnapshot Json?
  unitPrice       Int
  quantity        Int
  portions        Int    // total portions for this line
  flavorOptionId  Int?   // chosen flavor (no link, so the order stays even if the flavor is removed); used to give back its daily limit
  flavorMix       Json?  // mixed box: [{ "optionId": 3, "portions": 4 }] = portions of each flavor for the whole line
  note            String?
}

// ---------- Delivery and capacity ----------

// Districts the shop delivers to. No fee here: customers pay the driver directly.
model DeliveryZone {
  id        Int     @id @default(autoincrement())
  nameVi    String
  nameEn    String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  orders    Order[]
}

// Portions of one cake booked for one delivery day (only used when the cake has a daily limit).
model ProductDayBooking {
  productId      Int
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  bookedPortions Int      @default(0)

  @@id([productId, date])
}

// Portions already booked per flavor and delivery day (only flavors with their own daily limit).
model ProductOptionDayBooking {
  optionId       Int
  option         ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  bookedPortions Int           @default(0)

  @@id([optionId, date])
}

model DailyCapacity {
  date           DateTime @id @db.Date
  maxPortions    Int
  bookedPortions Int      @default(0)
}

// Single-row table (id = 1) holding shop-wide settings editable in the admin page.
model ShopSetting {
  id                   Int      @id @default(1)
  largeOrderThreshold  Int      @default(10) // orders with this many portions or more are "large"
  smallOrderLeadHours  Int      @default(3)  // minimum hours in advance for small orders
  largeOrderLeadHours  Int      @default(24) // minimum hours in advance for large orders
  defaultDailyCapacity Int      @default(20) // portions per day when no DailyCapacity row exists
  maxDaysAhead         Int      @default(7)  // how many days ahead customers may order
  openTime             String   @default("09:00") // ASAP orders must be ready between these times
  closeTime            String   @default("20:00")
  unpaidCancelMinutes  Int      @default(30) // unpaid orders are cancelled after this many minutes
  deliverySlots        String[] @default(["09:00-11:00", "11:00-13:00", "14:00-16:00", "16:00-18:00", "18:00-20:00"])
  closedWeekdays       Int[]    @default([]) // 0 = Sunday ... 6 = Saturday
  bankBin              String?  // VietQR bank code (BIN), e.g. "970436" for Vietcombank
  bankName             String?
  bankAccountNumber    String?
  bankAccountName      String?
  phone                String?
  messengerUrl         String?
  facebookUrl          String?
  instagramUrl         String?
  tiktokUrl            String?
  // Business details shown in the footer and the policy pages
  legalName            String?  // registered business name, e.g. the household business name
  legalAddress         String?
  registrationNumber   String?  // business registration or tax number
  contactEmail         String?
  dataRetentionMonths  Int      @default(12) // customer details are erased this long after delivery
  orderingPaused       Boolean  @default(false) // "pause orders" switch for the whole shop
  pauseMessageVi       String?  // shown to customers while orders are paused
  pauseMessageEn       String?
  showSoldCount        Boolean  @default(false) // show "Sold 120" on the menu and product pages
  soldCountMinimum     Int      @default(10) // hide the number while a cake has sold fewer portions than this
  maxQuantityPerItem   Int      @default(20) // most portions of one cake (same choices) in one order
  reviewWindowDays     Int      @default(30) // buyers may review (and edit or delete) this many days after delivery
  maxReviewPhotos      Int      @default(4)  // photos per review (0 = no photos)
  reportAlertThreshold Int      @default(3)  // staff are told when a review or comment gets this many reports
  updatedAt            DateTime @updatedAt
}

// ---------- Admin ----------

// ADMIN: everything, including settings and accounts. STAFF: orders and stock only.
enum AdminRole {
  ADMIN
  STAFF
}

model AdminUser {
  id                 Int            @id @default(autoincrement())
  email              String         @unique
  passwordHash       String         // argon2id hash, never the password itself
  name               String
  role               AdminRole      @default(ADMIN) // accounts made before roles existed belong to the owner
  mustChangePassword Boolean        @default(false) // true after a temporary password was handed out
  isActive           Boolean        @default(true) // switch off instead of deleting, so the history stays
  failedLogins       Int            @default(0)
  lockedUntil        DateTime?      // set after too many wrong passwords
  lastLoginAt        DateTime?
  notifyNewOrders    Boolean        @default(true) // receives the "new order" emails
  createdAt          DateTime       @default(now())
  sessions           AdminSession[]
  passwordResets     AdminPasswordReset[]
  pushSubscriptions  AdminPushSubscription[]
  orderEvents        OrderEvent[]
  reviewComments     ReviewComment[] // replies written for the shop
  postComments       PostComment[]   // replies to news comments written for the shop
}

// A phone or computer that asked for push notifications about new orders.
// The keys are created by the browser and only let us send it messages.
model AdminPushSubscription {
  id          Int       @id @default(autoincrement())
  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  endpoint    String    @unique
  p256dh      String
  auth        String
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

// A "forgot password" link sent by email. Only the SHA-256 hash of the token is stored;
// each link works once and expires after a short time.
model AdminPasswordReset {
  id          Int       @id @default(autoincrement())
  tokenHash   String    @unique
  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, createdAt])
  @@index([expiresAt])
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored here.
model AdminSession {
  id          Int       @id @default(autoincrement())
  tokenHash   String    @unique
  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

// History of every change to an order: who did what, and when.
model OrderEvent {
  id          Int          @id @default(autoincrement())
  orderId     Int
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus?
  action      String       // e.g. "ADVANCE", "CANCEL", "AUTO_CANCEL", "REFUND"
  note        String?
  adminUserId Int?         // empty when the system did it (e.g. auto-cancel)
  adminUser   AdminUser?   @relation(fields: [adminUserId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

// ---------- Customer accounts ----------

// A customer who signed in with Google. We never see or store their Google password.
model Customer {
  id               Int               @id @default(autoincrement())
  googleSub        String            @unique // Google's permanent id for this person
  email            String
  name             String
  avatarUrl        String?
  phone            String?           // filled in by the customer, used to prefill checkout
  defaultAddress   String?
  defaultZoneId    Int?
  createdAt        DateTime          @default(now())
  lastLoginAt      DateTime          @default(now())
  sessions         CustomerSession[]
  orders           Order[]
  reviews          Review[]
  reviewComments   ReviewComment[]
  reviewVotes      ReviewVote[]
  reviewReports    ReviewReport[]
  postComments       PostComment[]
  postCommentReports PostCommentReport[]
  pushSubscriptions CustomerPushSubscription[]
  notifications     CustomerNotification[]
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored here.
model CustomerSession {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

// ---------- Reviews ----------

// A star rating with optional words, by someone who bought the cake: one per cake per delivered order.
model Review {
  id          Int             @id @default(autoincrement())
  productId   Int
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  Int?            // set when written from a signed-in account
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  displayName String          // short public name, e.g. "Anh N."
  flavor      String?         // what was bought, e.g. "Matcha · Box of 4" (Vietnamese text)
  flavorEn    String?
  rating      Int             // 1 to 5
  body        String?
  photos      String[]        @default([]) // up to 4 photo URLs on our image storage
  upvotes     Int             @default(0)
  downvotes   Int             @default(0)
  reportCount Int             @default(0)
  hiddenAt    DateTime?       // hidden by staff
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  comments    ReviewComment[]
  votes       ReviewVote[]
  reports     ReviewReport[]

  @@unique([orderId, productId])
  @@index([productId, hiddenAt])
}

// A comment under a review (parentId empty) or a reply to such a comment (only two levels).
model ReviewComment {
  id          Int             @id @default(autoincrement())
  reviewId    Int
  review      Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parentId    Int?
  parent      ReviewComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ReviewComment[] @relation("CommentReplies")
  customerId  Int?            // the signed-in customer who wrote it
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminUserId Int?            // set for replies written by the shop
  adminUser   AdminUser?      @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  displayName String
  body        String?         // empty once deleted (kept so replies still make sense)
  photoUrl    String?         // one photo, only from customers who bought this cake
  upvotes     Int             @default(0)
  downvotes   Int             @default(0)
  reportCount Int             @default(0)
  hiddenAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  votes       ReviewVote[]
  reports     ReviewReport[]

  @@index([reviewId, createdAt])
}

// Up (+1) or down (-1) vote by a signed-in customer on a review or a comment.
model ReviewVote {
  id         Int            @id @default(autoincrement())
  customerId Int
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reviewId   Int?
  review     Review?        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  commentId  Int?
  comment    ReviewComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  value      Int
  createdAt  DateTime       @default(now())

  @@unique([customerId, reviewId])
  @@unique([customerId, commentId])
}

// "Report" by a signed-in customer; staff see reported items first.
model ReviewReport {
  id         Int            @id @default(autoincrement())
  customerId Int
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reviewId   Int?
  review     Review?        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  commentId  Int?
  comment    ReviewComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([customerId, reviewId])
  @@unique([customerId, commentId])
}

// A customer's browser that gets push notifications: order status changes and replies to their
// reviews or comments. Linked to an account when switched on while signed in.
model CustomerPushSubscription {
  id         Int              @id @default(autoincrement())
  endpoint   String           @unique
  p256dh     String
  auth       String
  locale     String           @default("vi")
  customerId Int?
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  watches    OrderPushWatch[]

  @@index([customerId])
}

// One order followed by a browser (used by guests who ordered without an account).
model OrderPushWatch {
  id             Int                      @id @default(autoincrement())
  subscriptionId Int
  subscription   CustomerPushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  orderId        Int
  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime                 @default(now())

  @@unique([subscriptionId, orderId])
  @@index([orderId])
}

// The bell list on the website for signed-in customers. The text is built when it is read,
// in the reader's language, from "kind" and "values" (see content/customer-alerts.json).
model CustomerNotification {
  id         Int       @id @default(autoincrement())
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String    // e.g. "status.CONFIRMED", "reviewReply", "commentReply"
  values     Json      // e.g. { "code": "AB12CD" } or { "name": "Anh N.", "productVi": "...", ... }
  path       String    // page to open, without the language, e.g. "/track?code=AB12CD"
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

enum PostCategory {
  NEWS     // general announcement
  NEW_CAKE // a cake is coming or just arrived
  UPDATE   // changes to the shop or the website
  EVENT    // promotion, holiday, market stall...
  LETTER   // a few words from the shop
}

// News page: posts written by admins. Shown when published and publishAt has passed.
// Texts are Markdown-like (see frontend/src/components/news/PostBody.tsx); English is optional.
model Post {
  id            Int          @id @default(autoincrement())
  slug          String       @unique
  category      PostCategory @default(NEWS)
  titleVi       String
  titleEn       String?
  summaryVi     String?      // short text on the card; empty = start of the post
  summaryEn     String?
  bodyVi        String       @db.Text
  bodyEn        String?      @db.Text
  coverImageUrl String?
  isPublished   Boolean      @default(false) // false = draft
  isPinned      Boolean      @default(false) // pinned posts stay on top
  allowComments Boolean      @default(true)  // off = old comments stay visible, no new ones
  comments      PostComment[]
  publishAt     DateTime     @default(now())  // a later time = scheduled
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isPublished, publishAt])
}

// Comments under a news post (signed-in customers; two levels: comment and replies).
model PostComment {
  id          Int                 @id @default(autoincrement())
  postId      Int
  post        Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId    Int?                // the top comment this replies to
  parent      PostComment?        @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     PostComment[]       @relation("PostCommentReplies")
  customerId  Int?
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminUserId Int?                // written as the shop
  adminUser   AdminUser?          @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  displayName String              // short public name, e.g. "Anh N.", or "Chuvachi"
  body        String?             // empty once deleted (kept so replies still make sense)
  reportCount Int                 @default(0)
  hiddenAt    DateTime?           // hidden by staff
  deletedAt   DateTime?           // deleted by its writer
  createdAt   DateTime            @default(now())
  reports     PostCommentReport[]

  @@index([postId, createdAt])
}

model PostCommentReport {
  id         Int         @id @default(autoincrement())
  commentId  Int
  comment    PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([customerId, commentId])
}

