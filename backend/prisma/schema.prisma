// Prisma schema for the Chuvachi dessert shop (product showcase).
// All money values are stored in VND as whole numbers (Int).
// The online ordering models were removed for now; see the Git tag "ordering-backup".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum OptionType {
  FLAVOR  // e.g. passion fruit mousse, mango panna cotta
  PACKAGE // e.g. single cup, box of 4, box of 6
}

// ---------- Catalog ----------

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  nameVi    String
  nameEn    String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id            Int             @id @default(autoincrement())
  slug          String          @unique
  nameVi        String
  nameEn        String
  descriptionVi String?
  descriptionEn String?
  imageUrl      String?
  basePrice     Int             // price of one portion in VND
  isActive      Boolean         @default(true)
  isNew         Boolean         @default(false) // shows a "NEW" badge and appears under the "New" filter
  sortOrder     Int             @default(0)
  categoryId    Int
  category      Category        @relation(fields: [categoryId], references: [id])
  options       ProductOption[]
  comboItems    ComboItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ProductOption {
  id         Int        @id @default(autoincrement())
  productId  Int
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       OptionType
  nameVi     String
  nameEn     String
  priceDelta Int        @default(0) // extra price added to the base price
  portions   Int        @default(1) // portions per unit (PACKAGE only, e.g. box of 4 = 4)
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
}

model Combo {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  nameVi        String
  nameEn        String
  descriptionVi String?
  descriptionEn String?
  imageUrl      String?
  price         Int         // fixed combo price in VND
  isActive      Boolean     @default(true)
  items         ComboItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ComboItem {
  id        Int     @id @default(autoincrement())
  comboId   Int
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     // number of portions of this product in the combo
}

// ---------- Admin ----------

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
