# Copy to ~/chuvachi/api.env on the server and fill in. Never commit the real file.

NODE_ENV=production
PORT=4000

# The database container is called "db" inside the server. Same password as in ~/chuvachi/.env
DATABASE_URL=postgresql://chuvachi_admin:PASSWORD@db:5432/chuvachi_prod?sslmode=disable

# Visitors come through Cloudflare and Caddy
TRUST_PROXY=1
TRUST_CLOUDFLARE=1
CORS_ORIGINS=https://chuvachi.com

# Photos (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chuvachi-images
R2_PUBLIC_URL=https://img.chuvachi.com

# Google sign-in (same Client ID as the website)
GOOGLE_CLIENT_ID=

# Telegram (optional, leave empty for now)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_URL=https://chuvachi.com/admin/orders

# Email (Resend) for "forgot password" links. EMAIL_FROM must use the domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Chuvachi <no-reply@chuvachi.com>

# Cloudflare Turnstile secret key (bot check on orders)
TURNSTILE_SECRET_KEY=
