# Copy this file to ".env.local" for local development.

# Address of the backend API, used by the server to load the menu.
API_URL=http://localhost:4000

# Address of the backend API, used by the visitor's browser (checkout, order lookup).
# Locally it's the same address; on the real site it will be the public API domain.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public address of the R2 photo bucket (same as R2_PUBLIC_URL in the backend), no slash at the end
NEXT_PUBLIC_IMAGE_BASE_URL=""

# Google sign-in for customers: the "Client ID" from Google Cloud Console (it is public, not a secret)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
