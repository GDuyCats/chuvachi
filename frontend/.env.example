# Copy this file to ".env.local" for local development.

# Address of the backend API, used by the server to load the menu.
API_URL=http://localhost:4000

# Address of the backend API, used by the visitor's browser (checkout, order lookup).
# Locally it's the same address; on the real site it will be the public API domain.
NEXT_PUBLIC_API_URL=http://localhost:4000
